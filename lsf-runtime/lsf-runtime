#!/bin/sh
# Launcher for the lsf-runtime CLI (docs/design/lsf-runtime.md, Language →
# Distribution). It runs, first match wins:
#   1. $LSF_RUNTIME_BIN;
#   2. in a working tree (a .git at the plugin root) with go on PATH, a
#      build of the tree, into lsf-runtime/.build/;
#   3. the release pinned in lsf-runtime/dist/release, downloaded once into
#      ${LSF_RUNTIME_CACHE:-${XDG_CACHE_HOME:-~/.cache}/lsf-runtime}/release/
#      (created 0700: the cache is trusted between the check and the exec)
#      and checked against its sha256 pin on every run.
# Its own failures exit 125 with "lsf-runtime launcher:" on stderr; a
# binary it cannot exec exits as sh does (126, 127). It is run by its path
# under the plugin root, not through a symlink.
set -eu

die() {
	printf 'lsf-runtime launcher: %s\n' "$*" >&2
	exit 125
}

tmp=
# shellcheck disable=SC2154 # st is set in the trap
trap 'st=$?; [ -z "$tmp" ] || rm -f -- "$tmp"; exit "$st"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

for tool in awk dirname uname; do
	command -v "$tool" >/dev/null 2>&1 || die "$tool is not on PATH"
done
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || die "cannot find the launcher's directory"
root=$(dirname -- "$here")

if [ -n "${LSF_RUNTIME_BIN:-}" ]; then
	case $LSF_RUNTIME_BIN in
	*/*) ;;
	*) die "LSF_RUNTIME_BIN=$LSF_RUNTIME_BIN is not a path" ;;
	esac
	[ -f "$LSF_RUNTIME_BIN" ] && [ -x "$LSF_RUNTIME_BIN" ] ||
		die "LSF_RUNTIME_BIN=$LSF_RUNTIME_BIN is not an executable file"
	exec "$LSF_RUNTIME_BIN" "$@"
fi

untree=
if [ -e "$root/.git" ]; then
	if command -v go >/dev/null 2>&1; then
		command -v cmp >/dev/null 2>&1 || die "cmp is not on PATH"
		mkdir -p "$here/.build" || die "cannot create $here/.build"
		tmp=$here/.build/lsf-runtime.$$
		if ! out=$(GOFLAGS='' go -C "$here" build -buildvcs=false -o "$tmp" ./cli 2>&1); then
			printf '%s\n' "$out" >&2
			# A run's controls still reach its driver while the tree is
			# broken: they run the last build, which may differ from the
			# driver's.
			case ${1:-} in
			status | watch | pause | stop)
				if [ -f "$here/.build/lsf-runtime" ] && [ -x "$here/.build/lsf-runtime" ]; then
					printf 'lsf-runtime launcher: building the working tree %s failed (above); running the last build, %s\n' "$root" "$here/.build/lsf-runtime" >&2
					rm -f -- "$tmp"
					tmp=
					exec "$here/.build/lsf-runtime" "$@"
				fi
				;;
			esac
			die "building the working tree $root failed (above)"
		fi
		# An unchanged build leaves the binary a live driver re-executes.
		if cmp -s "$tmp" "$here/.build/lsf-runtime"; then
			rm -f -- "$tmp"
		else
			mv -f -- "$tmp" "$here/.build/lsf-runtime" || die "cannot install the build in $here/.build"
		fi
		tmp=
		exec "$here/.build/lsf-runtime" "$@"
	fi
	untree=1
fi

[ "$(uname -s)" = Linux ] || die "unsupported system $(uname -s): Linux only; set LSF_RUNTIME_BIN or run from a working tree with Go"
case $(uname -m) in
x86_64 | amd64) arch=amd64 ;;
aarch64 | arm64) arch=arm64 ;;
*) die "unsupported machine $(uname -m): linux amd64 and arm64 only" ;;
esac

for tool in mktemp chmod mv stat id; do
	command -v "$tool" >/dev/null 2>&1 || die "$tool is not on PATH"
done

pin=$here/dist/release
[ -r "$pin" ] || die "cannot read $pin"
tag=$(awk '$1 == "tag" { print $2; exit }' "$pin")
want=$(awk -v a="$arch" '$1 == "sha256" && $2 == a { print $3; exit }' "$pin")
if [ -z "$tag" ] || [ -z "$want" ]; then
	die "no release pinned for linux-$arch in $pin; set LSF_RUNTIME_BIN or run from a working tree with Go"
fi
case $tag in
*[!A-Za-z0-9._-]* | .*) die "bad tag $tag in $pin" ;;
esac
case $want in
*[!0-9a-f]*) die "bad sha256 $want for $arch in $pin" ;;
esac
[ ${#want} -eq 64 ] || die "bad sha256 $want for $arch in $pin"
if [ -n "$untree" ]; then
	printf 'lsf-runtime launcher: %s is a working tree but go is not on PATH; running release %s, not the tree\n' "$root" "$tag" >&2
fi

if command -v sha256sum >/dev/null 2>&1; then
	sha() { sha256sum -- "$1" | awk '{ print $1 }'; }
elif command -v shasum >/dev/null 2>&1; then
	sha() { shasum -a 256 -- "$1" | awk '{ print $1 }'; }
else
	die "neither sha256sum nor shasum is on PATH"
fi

# private refuses a directory another user owns or can write: the binary
# is trusted between its check and its exec.
private() {
	for d in "$@"; do
		m=$(stat -c '%u %a' -- "$d") || die "cannot stat $d"
		[ "${m%% *}" = "$(id -u)" ] || die "$d is not owned by this user; the release cache must be private"
		case ${m#* } in
		*[2367]? | *[2367]) die "$d is writable by group or others; the release cache must be private (chmod go-w)" ;;
		esac
	done
}

cache=${LSF_RUNTIME_CACHE:-}
if [ -z "$cache" ]; then
	case ${XDG_CACHE_HOME:-} in
	/*) cache=$XDG_CACHE_HOME/lsf-runtime ;;
	*)
		case ${HOME:-} in
		/*) cache=$HOME/.cache/lsf-runtime ;;
		*) die "HOME is unset or not absolute; set XDG_CACHE_HOME or LSF_RUNTIME_CACHE" ;;
		esac
		;;
	esac
fi
dir=$cache/release/$tag
bin=$dir/lsf-runtime-linux-$arch

if [ ! -e "$bin" ]; then
	command -v curl >/dev/null 2>&1 || die "curl is not on PATH; it downloads release $tag"
	base=https://github.com/duaneg/phronithm/releases/download
	proto='=https'
	if [ -n "${LSF_RUNTIME_RELEASE_URL:-}" ]; then
		base=$LSF_RUNTIME_RELEASE_URL
		proto='=https,file'
	fi
	url=$base/$tag/lsf-runtime-linux-$arch
	(umask 077 && mkdir -p "$dir") || die "cannot create $dir"
	private "$cache" "$cache/release" "$dir"
	tmp=$(mktemp "$dir/.download.XXXXXX") || die "cannot create a file in $dir"
	curl -q -fsSL --proto "$proto" --proto-redir '=https' --tlsv1.2 \
		--connect-timeout 30 --max-time 600 --max-filesize 268435456 -o "$tmp" "$url" ||
		die "downloading $url failed"
	got=$(sha "$tmp")
	if [ "$got" != "$want" ]; then
		rm -f -- "$tmp"
		tmp=
		die "$url has sha256 $got, but $pin pins $want; refused"
	fi
	chmod 755 "$tmp" || die "cannot chmod $tmp"
	mv -f -- "$tmp" "$bin" || die "cannot install $bin"
	tmp=
fi

private "$cache" "$cache/release" "$dir"
got=$(sha "$bin")
[ "$got" = "$want" ] || die "$bin has sha256 $got, but $pin pins $want; remove $bin and rerun"
exec "$bin" "$@"
