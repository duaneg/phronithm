{
  "stateDir": "/path/to/state",
  "repo": "/path/to/repo",
  "pluginDir": "/path/to/phronithm",
  "image": "localhost/lsf-project@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
  "claudeBin": "/path/to/claude/versions/2.1.294",
  "claudeVersion": "2.1.294",
  "env": [],
  "proxy": {"listen": "127.0.0.1:0", "credentialsFile": "/path/to/home/.claude/.credentials.json"},
  "args": {"name": "example", "planSha": "0123456789abcdef", "integrationBranch": "main", "architectureDoc": "docs/architecture/example.md"},
  "concurrency": 4,
  "defaultRole": "writer",
  "roles": {
    "writer": {
      "tools": "Read,Edit,Write,Glob,Grep,Bash,Skill",
      "clone": "kept"
    },
    "reviewer": {
      "tools": "Read,Glob,Grep,Bash,Skill",
      "clone": "discarded"
    }
  },
  "roleRules": [
    {"agentType": "phronithm:critic", "role": "reviewer"},
    {"label": "^(critique-(plan|design|code)|lens-review):r[0-9]+:", "role": "reviewer"},
    {"label": "^review-gate:w[0-9]+(#|$)", "role": "reviewer"},
    {"label": "^obligations(#|$)", "role": "reviewer"}
  ],
  "skills": [
    {"label": "^(critique-plan|critique-code|critique-design)", "skill": "phronithm:critique"},
    {"label": "^lens-review", "skill": "phronithm:review"},
    {"label": "^(replan|decision-replan)", "skill": "phronithm:breakdown"}
  ],
  "caps": {"maxCalls": 400, "maxWallClock": "48h", "maxCostUSD": 500},
  "guardTimeout": "3h",
  "killGrace": "10s",
  "backoff": ["5s", "20s", "60s"],
  "sessionLimitMargin": "30s",
  "sessionLimitFallback": "15m",
  "maxSessionWaits": 4
}
