#!/usr/bin/env bash
# Stub `claude -p --output-format stream-json` for the runtime's tests.
# Bash 3.2 compatible (macOS). The prompt is read from stdin. --version
# answers 0.0.0-stub before any record is made.
#
# STUB_SCRIPT   comma list of modes, one per invocation, the last repeating
#               (STUB_MODE is the single-mode form; default ok).
# STUB_STATE    directory for per-invocation records: count, argv.<n> (NUL-
#               separated), stdin.<n>, cwd.<n> (pwd -P), started.<n> (unix seconds), pids.<n>
#               ("leader grandchild"), reset.<n> (session mode's resetsAt),
#               and active/maxactive (concurrent invocations).
# STUB_PIDFILE  also receives the grandchild pid of a hang mode.
# STUB_RESET_IN seconds from now to the session-limit reset (default 1).
# STUB_DIRTY    a path the stub writes in its cwd before any mode runs.
#
# Modes: ok | cost:<usd> | nullout | invalid | slow:<secs> | transient |
#        session | session-noreset | bare429 (a 429 result, no assistant error) | hang | hang-ignore-term |
#        orphan-ignore-term | result-then-hang | fixture:<name> (cats streams/<name>.jsonl) |
#        dirty:<path> (writes <path> in cwd, then ok) | modify:<path> (appends to it, then ok) |
#        commit:<path> (writes <path>, commits it and tags the commit t-<path>, then ok) |
#        dirty-transient:<path> (writes <path>, then a 529) |
#        file:<path> (cats a stream file) | exit:<n> (exits n after its first lines) |
#        stage:<path> (writes "resolved" to <path> and git-adds it, then ok) |
#        nested:<marker> (commits a nested repo, sub, as a gitlink with a
#        .gitmodules ignore=none, its own filter touching <marker>, then
#        dirties it, then ok) |
#        probe (writes probe.txt in cwd: cwd, uid, which of .git/config,
#        .git/hooks/x, .git/info/x and the index can be written, env, and the
#        status of a request to $ANTHROPIC_BASE_URL with the bearer, then ok)
set -u
if [ "${1:-}" = --version ]; then echo "0.0.0-stub (Claude Code)"; exit 0; fi
here=$(cd "$(dirname "$0")" && pwd)
state="${STUB_STATE:-}"
n=1

lock() { # a lock older than ~2 s belongs to a killed stub
  local i=0
  while ! mkdir "$state/.lock" 2>/dev/null; do
    i=$((i + 1)); [ "$i" -gt 200 ] && rmdir "$state/.lock" 2>/dev/null
    sleep 0.01
  done
}
unlock() { rmdir "$state/.lock"; }
bump() { # name delta: adds delta to a counter file; tracks maxactive
  local v
  v=$(cat "$state/$1" 2>/dev/null || echo 0)
  v=$((v + $2))
  echo "$v" > "$state/$1"
  if [ "$1" = active ] && [ "$v" -gt "$(cat "$state/maxactive" 2>/dev/null || echo 0)" ]; then echo "$v" > "$state/maxactive"; fi
}
if [ -n "$state" ]; then
  mkdir -p "$state"
  lock
  n=$(( $(cat "$state/count" 2>/dev/null || echo 0) + 1 ))
  echo "$n" > "$state/count"
  bump active 1
  unlock
  printf '%s\0' "$@" > "$state/argv.$n"
  cat > "$state/stdin.$n"
  pwd -P > "$state/cwd.$n"
  date +%s > "$state/started.$n"
fi
[ -z "$state" ] && cat > /dev/null
finish() { if [ -n "$state" ]; then lock; bump active -1; unlock; fi; }

session=stub
prev=
for a in "$@"; do [ "$prev" = --session-id ] && session=$a; prev=$a; done

script="${STUB_SCRIPT:-${STUB_MODE:-ok}}"
IFS=, read -r -a modes <<< "$script"
i=$((n - 1))
[ "$i" -ge "${#modes[@]}" ] && i=$((${#modes[@]} - 1))
mode=${modes[$i]}
[ -n "${STUB_DIRTY:-}" ] && echo x > "$STUB_DIRTY"

init() { echo "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"$session\",\"tools\":[\"Read\",\"Bash\"],\"slash_commands\":[]}"; }
result_ok() { echo "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"structured_output\":$1,\"total_cost_usd\":${2:-0.01}}"; }
hang() { # $1: leader TERM disposition, $2: grandchild TERM disposition
  [ "$1" = ignore ] && trap '' TERM
  if [ "$2" = ignore ]; then (trap '' TERM; exec sleep 300) & else sleep 300 & fi
  g=$!
  [ -n "${STUB_PIDFILE:-}" ] && echo "$g" > "$STUB_PIDFILE"
  [ -n "$state" ] && echo "$$ $g" > "$state/pids.$n"
  while :; do wait; sleep 1; done
}

case "$mode" in
  fixture:*) ;;
  *) init; echo '{"type":"assistant","message":{"content":[{"type":"text","text":"working"}]}}' ;;
esac
code=0
case "$mode" in
  ok)        result_ok '{"verdict":"pass","n":3}' ;;
  cost:*)    result_ok '{"verdict":"pass","n":3}' "${mode#cost:}" ;;
  nullout)   echo '{"type":"result","subtype":"success","is_error":false,"structured_output":null}' ;;
  invalid)   result_ok '{"wrong":1}' ;;
  slow:*)    sleep "${mode#slow:}"; result_ok '{"verdict":"pass","n":3}' ;;
  transient) echo '{"type":"assistant","error":"overloaded","message":{"content":[{"type":"text","text":"Overloaded"}]}}'
             echo '{"type":"result","subtype":"success","is_error":true,"api_error_status":529,"total_cost_usd":0}'; code=1 ;;
  session|session-noreset)
             echo '{"type":"assistant","error":"rate_limit","message":{"content":[{"type":"text","text":"You'"'"'ve hit your session limit"}]}}'
             if [ "$mode" = session ]; then
               r=$(( $(date +%s) + ${STUB_RESET_IN:-1} ))
               [ -n "$state" ] && echo "$r" > "$state/reset.$n"
               echo "{\"type\":\"rate_limit_event\",\"rate_limit_info\":{\"status\":\"rejected\",\"resetsAt\":$r,\"rateLimitType\":\"five_hour\"}}"
             fi
             echo '{"type":"result","subtype":"success","is_error":true,"api_error_status":429,"total_cost_usd":0}'; code=1 ;;
  bare429)   echo '{"type":"result","subtype":"success","is_error":true,"api_error_status":429,"total_cost_usd":0}'; code=1 ;;
  hang)               hang default default ;;
  result-then-hang)   result_ok '{"verdict":"pass","n":3}'; hang default default ;;
  hang-ignore-term)   hang ignore ignore ;;
  orphan-ignore-term) hang default ignore ;;
  dirty:*)   echo x > "${mode#dirty:}"; result_ok '{"verdict":"pass","n":3}' ;;
  modify:*)  echo more >> "${mode#modify:}"; result_ok '{"verdict":"pass","n":3}' ;;
  commit:*)  f=${mode#commit:}; echo "$n" > "$f"
             if git add -- "$f" >&2 && git commit -q -m "$f" >&2 && git tag -f "t-$f" >&2; then result_ok '{"verdict":"pass","n":3}'
             else echo "stub: commit failed in $(pwd)" >&2; code=2; fi ;;
  dirty-transient:*)
             echo x > "${mode#dirty-transient:}"
             echo '{"type":"result","subtype":"success","is_error":true,"api_error_status":529,"total_cost_usd":0}'; code=1 ;;
  fixture:*) cat "$here/streams/${mode#fixture:}.jsonl" ;;
  file:*)    cat "${mode#file:}" ;;
  exit:*)    code=${mode#exit:} ;;
  nested:*)  g() { git -c user.name=stub -c user.email=stub@example.invalid "$@" >&2; }
             m=${mode#nested:}
             git init -q sub >&2
             printf '[filter "x"]\n\tclean = touch %s && cat\n' "$m" >> sub/.git/config
             echo '* filter=x' > sub/.gitattributes; echo data > sub/f
             printf '[submodule "sub"]\n\tpath = sub\n\tignore = none\n' > .gitmodules
             g -C sub add -A && g -C sub commit -q -m sub && g add sub .gitmodules && g commit -q -m gitlink || code=2
             rm -f "$m" # made by the commits above, the stub's own git
             echo more >> sub/f; touch -d 2000-01-01 sub/f
             [ "$code" = 0 ] && result_ok '{"verdict":"pass","n":3}' ;;
  stage:*)   f=${mode#stage:}; echo resolved > "$f"
             if git add -- "$f" >&2; then result_ok '{"verdict":"pass","n":3}'; else code=2; fi ;;
  probe)     {
               echo "cwd=$(pwd -P)"
               echo "uid=$(id -u)"
               if mv .git .git.moved 2>/dev/null; then mv .git.moved .git; echo "writable=.git-rename"; else echo "readonly=.git-rename"; fi
               for p in .git/config .git/hooks/x .git/info/x; do
                 if (echo x >> "$p") 2>/dev/null; then echo "writable=$p"; else echo "readonly=$p"; fi
               done
               : > probe-staged
               if git add probe-staged 2>/dev/null; then echo "index=writable"; else echo "index=readonly"; fi
               echo "status=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer ${ANTHROPIC_AUTH_TOKEN:-}" "${ANTHROPIC_BASE_URL:-http://127.0.0.1:1}/v1/probe")"
               env | sed 's/^/env:/'
             } > probe.txt
             result_ok '{"verdict":"pass","n":3}' ;;
  *) echo "stub: unknown mode $mode" >&2; code=2 ;;
esac
finish
exit "$code"
