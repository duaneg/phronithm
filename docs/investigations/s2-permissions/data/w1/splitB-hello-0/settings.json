{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "~",
        "<scratch>/w1/secrets"
      ],
      "allowWrite": [
        "<scratch>/w1/calls/splitB-hello-0"
      ]
    },
    "network": {
      "allowedDomains": [
        "127.0.0.1:18432"
      ],
      "strictAllowlist": true
    },
    "credentials": {
      "envVars": [
        {
          "name": "CLAUDE_CODE_OAUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "LSF_CANARY_SECRET",
          "mode": "deny"
        }
      ]
    }
  }
}
