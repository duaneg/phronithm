{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "~",
        "/tmp/lsfp/w2/secrets",
        "/run/containerd"
      ],
      "allowWrite": [
        "/tmp/lsfp/w2/calls/splitB-branch-1"
      ]
    },
    "network": {
      "allowedDomains": [
        "localhost:18432"
      ],
      "strictAllowlist": true
    },
    "credentials": {
      "envVars": [
        {
          "name": "CLAUDE_CODE_OAUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "LSF_CANARY_SECRET",
          "mode": "deny"
        }
      ]
    }
  }
}
