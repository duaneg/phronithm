{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "~",
        "/tmp/lsfp/w2/secrets",
        "/run/containerd"
      ],
      "allowWrite": [
        "/tmp/lsfp/w2/calls/B2-docker-1"
      ]
    },
    "network": {
      "allowedDomains": [
        "127.0.0.1:18433"
      ],
      "strictAllowlist": true
    }
  }
}
