{
  "filesystem": {
    "denyRead": [
      "~",
      "/tmp/lsfp/w2/secrets",
      "/var/run/docker.sock",
      "/run/docker.sock",
      "/run/containerd"
    ],
    "allowRead": [
      "<scratch>/w1/bin"
    ],
    "allowWrite": [
      "/tmp/lsfp/w2/calls/srtA+-docker-1",
      "/tmp/lsfp/w2/homes/srtA+-docker-1",
      "/tmp/lsfp/lYna"
    ],
    "denyWrite": []
  },
  "network": {
    "allowedDomains": [
      "api.anthropic.com",
      "localhost:18432",
      "127.0.0.1:18432"
    ],
    "deniedDomains": [],
    "tlsTerminate": {},
    "allowPlaintextInject": true,
    "allowAllUnixSockets": true
  },
  "credentials": {
    "envVars": [
      {
        "name": "CLAUDE_CODE_OAUTH_TOKEN",
        "mode": "mask",
        "injectHosts": [
          "api.anthropic.com"
        ]
      },
      {
        "name": "LSF_CANARY_SECRET",
        "mode": "mask",
        "injectHosts": [
          "api.anthropic.com",
          "localhost"
        ]
      }
    ]
  }
}
